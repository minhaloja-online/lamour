/* ============================================================
   L'amour Essência — regras do Storage do Firebase (opcional)
   Só é necessário se você for enviar fotos pelo painel usando o
   Firebase. O Storage exige o plano Blaze (cartão cadastrado).

   Firebase Console -> Storage -> Regras -> colar -> Publicar
   Troque COLE_O_UID_AQUI pelo UID da administradora.
   ============================================================ */
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /fotos/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'COLE_O_UID_AQUI';
    }
  }
}
